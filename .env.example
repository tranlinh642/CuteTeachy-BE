# =============================================================================
# Cấu hình môi trường CuteTeachy-BE (Local Dev & Testing)
# Copy file này thành .env: `cp .env.example .env`
# =============================================================================

# --- Ứng dụng & Server ---
PORT=4000
NODE_ENV=development
FE_URL=http://localhost:3000

# --- Cơ sở dữ liệu (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cuteteachy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cuteteachy?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/cuteteachy?schema=public

# --- Authentication & JWT ---
# Khóa bí mật ký JWT access token (tối thiểu 32 ký tự)
JWT_SECRET=dev-jwt-secret-key-cute-teachy-at-least-32-chars
# Hạn access token (SPEC-002: 15 phút)
JWT_EXPIRES_IN=15m
# TTL refresh token khi bật remember (SPEC-002: 30 ngày)
REFRESH_TOKEN_TTL_REMEMBER=30d
# TTL refresh token khi không bật remember (SPEC-002: 1 ngày)
REFRESH_TOKEN_TTL_SESSION=1d

# --- Google OAuth (BE-05) ---
GOOGLE_CLIENT_ID=mock-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Object Storage (MinIO local / Cloudflare R2 production - BE-06) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_AVATARS=avatars
S3_PUBLIC_BASE_URL=http://localhost:9000/avatars

# --- Email / SMTP (Mailpit local / Gmail SMTP production - BE-07) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CuteTeachy <no-reply@cuteteachy.local>

# --- Xác minh email (BE-07) ---
# Mặc định false cho tới khi ticket giai đoạn cuối hoàn tất (SPEC-002)
EMAIL_VERIFICATION_REQUIRED=false

# --- Web Push VAPID (SPEC-005) ---
# Tạo cặp khóa VAPID cho dev bằng lệnh: npx web-push generate-vapid-keys
# Khóa công khai chia sẻ với FE
VAPID_PUBLIC_KEY=
# Khóa bí mật chỉ lưu trên BE (không commit khóa thật production)
VAPID_PRIVATE_KEY=
# Subject liên hệ (mailto: hoặc URL)
VAPID_SUBJECT=mailto:dev@cuteteachy.local

# --- Cron Dispatcher (SPEC-005, ADR 0002) ---
CRON_SECRET=dev-cron-secret-token
